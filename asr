#!/usr/bin/env bash
# Runs TuxWhisper from a git clone: the package in tuxwhisper/ with the clone's .venv.
# Also puts pip-installed cuDNN/cuBLAS and whisper.cpp libraries (if any) on the library path.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for SITE in "$DIR"/.venv/lib/python3*/site-packages; do
    [ -d "$SITE/nvidia" ] && export LD_LIBRARY_PATH="$SITE/nvidia/cudnn/lib:$SITE/nvidia/cublas/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    [ -e "$SITE/libwhisper.so.1" ] && export LD_LIBRARY_PATH="$SITE${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
done
export TUXWHISPER_CMD="$DIR/asr" TUXWHISPER_LIBS_SET=1 PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$DIR/.venv/bin/python" -m tuxwhisper "$@"
