[Unit]
Description=Local dictation daemon (faster-whisper)
PartOf=graphical-session.target
After=graphical-session.target
# A daemon that can't start (no GPU, a missing library) stops retrying after 3 tries
# in 5 minutes, instead of restarting and notifying forever.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Optional settings, see docs/configuration.md:
# Environment=ASR_LANGUAGE=en
# Environment=OLLAMA_URL=http://localhost:11434
# Edit this path if you cloned the repo somewhere other than ~/tuxwhisper.
ExecStart=%h/tuxwhisper/asr serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
